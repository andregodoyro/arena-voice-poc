# ============================================================
# ARENA VOICE POC - CONFIGURACAO DE AMBIENTE (.env)
# ============================================================
#
# Copie este arquivo para ".env" e ajuste apenas o necessario.
# O arquivo .env NUNCA deve ser versionado no Git.
#
# Em ambientes de producao, CI/CD ou nuvem (ex: Oracle Cloud / Linux),
# as variaveis podem ser injetadas diretamente pelo container/sistema.
# ============================================================

# ------------------------------------------------------------
# 1. SERVIDOR BACKEND (.NET)
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# ------------------------------------------------------------
# 2. FRONTEND (Vite / React)
# ------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:5000
VITE_SIGNALR_URL=http://localhost:5000/hubs/arena-poc

# ------------------------------------------------------------
# 3. BANCO DE DADOS (PostgreSQL)
# ------------------------------------------------------------
# Utilizado para conexao nativa, EF Core e migracao
ARENA_STORAGE_ENGINE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=arena_voice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# String de conexao completa (sobrescreve parametros individuais se preenchida)
# CONNECTION_STRING=Host=localhost;Port=5432;Database=arena_voice;Username=postgres;Password=postgres;

# ------------------------------------------------------------
# 4. BACKUP & DISASTER RECOVERY (Milestone 4D)
# ------------------------------------------------------------
BACKUP_DIRECTORY=backups
PG_DUMP_EXE=
PG_RESTORE_EXE=

# ------------------------------------------------------------
# 5. EXECUTAVEIS E FERRAMENTAS LOCAIS (Opcional)
# ------------------------------------------------------------
# Se estiverem no PATH do sistema, deixe em branco.
DOTNET_EXE=
NODE_EXE=
NPM_EXE=
GIT_EXE=
PSQL_EXE=

# ------------------------------------------------------------
# 6. INFRAESTRUTURA DE NUVEM FUTURA (Oracle Cloud Infrastructure)
# ------------------------------------------------------------
OCI_REGION=
OCI_BUCKET=
OCI_NAMESPACE=
